{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/art/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/verk/impresjonistisk-hagefest-ved-innsjen/",
      "destination": "/verk/impresjonistisk-hagefest-ved-elven/",
      "permanent": true
    },
    {
      "source": "/verk/romantisk-solnedgang-pa-verandaen/",
      "destination": "/verk/melankolsk-solnedgang-ved-havet/",
      "permanent": true
    },
    {
      "source": "/verk/stormlys-over-det-gamle-fjordlandskapet/",
      "destination": "/verk/vandreren-ved-det-stormfulle-fjordlandskapet/",
      "permanent": true
    },
    {
      "source": "/verk/modig-bykvinne-i-graffitiunivers/",
      "destination": "/verk/modig-dronning-i-fargerik-gatekunst/",
      "permanent": true
    },
    {
      "source": "/verk/renessansebibliotek-med-lrde-og-solnedgang/",
      "destination": "/verk/renessansestudie-med-symbolske-skatter/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/artwork/:id/",
      "destination": "/api/artwork-page?id=:id"
    },
    {
      "source": "/artwork-sitemap.xml",
      "destination": "/api/artwork-sitemap"
    }
  ]
}
