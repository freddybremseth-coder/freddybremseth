# Set these in the ART Vercel project only; never in the browser or GitHub.
SITE_URL=https://art.freddybremseth.com
STRIPE_SECRET_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ART_STORAGE_BUCKET=art-originals
# Keep false until private masters have been uploaded, the merchant details reviewed, and a live checkout tested.
DIGITAL_SALES_ENABLED=false
# Optional: requires Stripe Tax configuration. Price is specified as tax-inclusive when enabled.
STRIPE_AUTOMATIC_TAX=false

# Prodigi print-on-demand. Start in sandbox; Live orders are produced and charged.
PRODIGI_ENVIRONMENT=sandbox
PRODIGI_API_KEY=
# Physical checkout stays fail-closed until all three switches are explicitly approved.
PRINT_SALES_ENABLED=false
PRINT_SAMPLE_APPROVED=false
PRINT_LEGAL_APPROVED=false
# Stripe webhook endpoint: https://art.freddybremseth.com/api/stripe-webhook
STRIPE_WEBHOOK_SECRET=
# Retail formula: the higher of wholesale item cost × multiplier or the curated size-tier floor; shipping is passed through separately.
# Conversion-led fine-art floors: 8–12in €59 · 14in €79 · 16–18in €99 · 20–24in €139 · 25–30in €179 · larger €249.
PRINT_COST_MULTIPLIER=2
PRINT_ROUND_TO_CENTS=500

# Promotions are OFF unless mode + valid start/end are explicitly configured.
# Modes: off | percent | free_shipping. Use real, time-limited campaigns rather than permanent discounts.
PRINT_PROMOTION_MODE=off
PRINT_PROMOTION_PERCENT=17
PRINT_PROMOTION_LABEL=Introduction Edition
PRINT_PROMOTION_START=
PRINT_PROMOTION_END=
