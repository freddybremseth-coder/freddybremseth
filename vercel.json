{
  "routes": [
    {
      "has": [
        {
          "type": "host",
          "value": "books.freddybremseth.com"
        }
      ],
      "src": "/assets/(.*)",
      "dest": "/books/assets/$1"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "books.freddybremseth.com"
        }
      ],
      "src": "/(sitemap\\.xml|robots\\.txt)",
      "dest": "/books/$1"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "books.freddybremseth.com"
        }
      ],
      "src": "/(en|es)/book/(the-facade-of-justice|shadows-of-the-past|the-ascendants|birokt-og-oliven|fra-jord-til-bord|polyfenolens-kraft)/?",
      "dest": "/books/seo/$1/$2.html"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "books.freddybremseth.com"
        }
      ],
      "src": "/book/(the-facade-of-justice|shadows-of-the-past|the-ascendants|birokt-og-oliven|fra-jord-til-bord|polyfenolens-kraft)/?",
      "dest": "/books/seo/no/$1.html"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "books.freddybremseth.com"
        }
      ],
      "src": "/(.*)",
      "dest": "/books/index.html"
    },
    {
      "src": "/",
      "dest": "/home.html"
    },
    {
      "src": "/artikler/([^./]+)",
      "dest": "/artikler/index.html"
    },
    {
      "src": "/book",
      "status": 308,
      "headers": {
        "Location": "/avtale"
      }
    },
    {
      "src": "/avtale",
      "dest": "/avtale.html"
    },
    {
      "src": "/forfatter(\\.html)?",
      "status": 308,
      "headers": {
        "Location": "https://books.freddybremseth.com/"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
