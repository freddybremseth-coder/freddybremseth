    },
    {
      "src": "/book",
      "status": 308,
      "headers": {
        "Location": "/avtale"
      }
    },
    {
      "src": "/avtale",
      "dest": "/avtale.html"
    },
    {
      "src": "/forfatter(\\.html)?",
